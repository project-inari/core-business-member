POST http://localhost:8080/v1/invite
Content-Type: application/json
{
    "inviterUsername": "user1",
    "inviteeUsername": "user2",
    "businessName": "business2"
}

POST http://localhost:8080/v1/invite/accept
Content-Type: application/json
{
    "inviteeUsername": "user2",
    "businessName": "business1"
}

POST http://localhost:8080/v1/invite/decline
Content-Type: application/json
{
    "inviteeUsername": "user2",
    "businessName": "business1"
}

GET http://localhost:8080/v1/joining
    ?username=user2
    &businessName=business1
    &status=INVITE_ACCEPTED
